# Environment Variables for KOKO
# Copy this file to .env and fill in your values

# Resend API key for journal email delivery
RESEND_API_KEY=your_resend_api_key_here

# Optional: override the recipient email address
TO_EMAIL=recipient@example.com

# SHA-256 hash of the access passphrase (lowercase hex)
# Generate with: echo -n "your passphrase" | sha256sum
VITE_ACCESS_PASSPHRASE_HASH=your_sha256_hash_here

# YouTube API Key for search and playback proxy (server-side only)
YOUTUBE_API_KEY=your_youtube_api_key_here
